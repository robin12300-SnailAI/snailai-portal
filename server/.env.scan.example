# ── Snail AI Business Opportunity Scan — Environment Variables ──
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ── App ──
APP_ENV=development                  # development | staging | production
PUBLIC_BASE_URL=http://localhost:5000 # Production: https://snailai.ai

# ── Database ──
DB_PATH=/data/snailai.db             # Render persistent disk; local: server/snailai.db

# ── AI Model (GLM5.3) ──
AI_API_KEY=                          # GLM API key (required for AI analysis)
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5.3
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2

# ── Email ──
GMAIL_USER=robin@snailai.ai
GMAIL_APP_PASSWORD=                  # Google App Password
ROBIN_NOTIFICATION_EMAIL=robin12300@gmail.com
SCAN_EMAIL_FROM=scan@snailai.ai      # Google Workspace alias

# ── Cloudflare Turnstile ──
TURNSTILE_SECRET_KEY=                # From Cloudflare dashboard
TURNSTILE_SITE_KEY=                  # For frontend widget

# ── Report Security ──
REPORT_TOKEN_SECRET=                 # Random secret for token generation
REPORT_LINK_EXPIRY_DAYS=30
REPORT_RETENTION_DAYS=90
SCAN_REPORT_DIR=/data/scan-reports   # PDF storage directory

# ── WeChat Notification ──
WECHAT_WEBHOOK_URL=                  # WeChat Work webhook for Robin notifications

# ── Admin Auth ──
ADMIN_AUTH_SECRET=                   # Shared secret for admin API access
